/*
1- write a query to produce below output from icc_world_cup table.
team_name, no_of_matches_played , no_of_wins , no_of_losses 
*/

SELECT * FROM icc_world_cup;

SELECT team_name, 
COUNT(1) AS no_of_matches_played
, SUM(win_flag) AS no_of_wins
, COUNT(1) - SUM(win_flag) AS no_of_losses
FROM 
(
SELECT team_1 AS team_name, CASE WHEN team_1 = winner THEN 1 ELSE 0 END AS win_flag FROM icc_world_cup
UNION ALL
SELECT team_2, CASE WHEN team_2 = winner THEN 1 ELSE 0 END AS win_flag FROM icc_world_cup
) all_matches
GROUP BY team_name ;

